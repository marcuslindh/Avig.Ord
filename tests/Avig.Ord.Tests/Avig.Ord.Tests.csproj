<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="10.1.1" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.12.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5" />
    <!-- Tests only: Microsoft's schema validator checks that the files we write are
         valid OOXML. The library itself does not depend on it. -->
    <PackageReference Include="DocumentFormat.OpenXml" Version="3.5.1" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <Using Include="Avig" />
    <Using Include="Avig.Ord" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Avig.Ord\Avig.Ord.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Documents Word made, with Word's own reading of them (tools/Avig.Ord.WordCheck create). -->
    <None Include="WordFiles\**" CopyToOutputDirectory="PreserveNewest" />
    <!-- The comparison is the one the Word check uses, so that the two cannot drift apart. -->
    <Compile Include="..\..\tools\Avig.Ord.WordCheck\Report.cs" Link="WordCheck\Report.cs" />
    <Compile Include="..\..\tools\Avig.Ord.WordCheck\OrdSide.cs" Link="WordCheck\OrdSide.cs" />
  </ItemGroup>

</Project>
