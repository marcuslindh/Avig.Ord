<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- Avig.OpenXml is 0.x in the local feed until it is released together with Avig.Kalkyl 1.0.0 and Avig.Ord 1.0.0
       (decision in Knowledge: "Avig.Ord — Beslut: Gemensamt paket Avig.OpenXml"). The publish
       workflow cannot reach G:\, so Avig.OpenXml must be on nuget.org before a tag is pushed. -->
  <packageSources>
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <add key="LocalNugetRepo" value="G:\LocalNugetRepo" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="LocalNugetRepo">
      <package pattern="Avig.OpenXml" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
