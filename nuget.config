<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- Every Avig dependency (Avig.Result, Avig.OpenXml, Avig.Analyzers) comes from nuget.org, as on the
       publish workflow's runner. A prerelease of Avig.OpenXml from G:\LocalNugetRepo goes in a
       nuget.config of the working copy that tries it, and never into a commit that is tagged. -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
