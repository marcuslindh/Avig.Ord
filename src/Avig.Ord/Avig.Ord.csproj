<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>

    <!-- Turns on the trimming and AOT analyzers. The package must work in a Native AOT app. -->
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

  <PropertyGroup>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <PropertyGroup>
    <!-- 0.x until all milestones are done. The first public version will be 1.0.0. -->
    <IsPackable>true</IsPackable>
    <PackageId>Avig.Ord</PackageId>
    <Version>0.1.2</Version>
    <Title>Avig.Ord</Title>
    <Description>Read, write and edit Word .docx files: a streaming reader and writer, a document model that keeps what it does not understand, effective formatting through the style chain, list labels, tracked changes, search and replace across runs, templates with placeholders, merge fields and content controls, and text or Markdown out. Failures come back as Avig.Result values. No dependencies besides Avig.Result and Avig.OpenXml; trimming and Native AOT safe.</Description>
    <PackageTags>word;docx;dotx;docm;wordprocessingml;openxml;template;mail-merge;markdown</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avig.Result" Version="1.0.2" />
    <PackageReference Include="Avig.OpenXml" Version="0.2.3" />
  </ItemGroup>

  <ItemGroup>
    <!-- Length lives in Avig.OpenXml, shared with Avig.Kalkyl and Avig.Bildspel. -->
    <Using Include="Avig.OpenXml" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>

  <ItemGroup>
    <!-- The source generator is built before the package but not referenced by it: it ships under
         analyzers/dotnet/cs, where the compiler of whoever uses the package finds it. -->
    <ProjectReference Include="..\Avig.Ord.Generators\Avig.Ord.Generators.csproj" ReferenceOutputAssembly="false" PrivateAssets="all" />
    <None Include="..\Avig.Ord.Generators\bin\$(Configuration)\netstandard2.0\Avig.Ord.Generators.dll" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Avig.Ord.Tests" />
    <InternalsVisibleTo Include="Avig.Ord.Fuzz" />
  </ItemGroup>

</Project>
